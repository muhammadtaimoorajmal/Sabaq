{
  "name": "sabaq",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source academic companion: every deadline, announcement and submission rule in one structured place.",
  "license": "MIT",
  "author": "Muhammad Taimoor Ajmal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadtaimoorajmal/Sabaq.git"
  },
  "homepage": "https://github.com/muhammadtaimoorajmal/Sabaq#readme",
  "bugs": "https://github.com/muhammadtaimoorajmal/Sabaq/issues",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta --kill-others-on-fail \"npm run dev -w @sabaq/api\" \"npm run dev -w @sabaq/web\"",
    "dev:api": "npm run dev -w @sabaq/api",
    "dev:web": "npm run dev -w @sabaq/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.course\" \"#test-results\" \"#playwright-report\"",
    "lint:links": "node scripts/check-links.mjs",
    "lint:research": "node scripts/research/check-insights.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run lint:md && npm run lint:links && npm run lint:research && npm run typecheck && npm run test && npm run build",
    "research:survey": "node scripts/research/analyze-survey.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "chrome-launcher": "1.2.3",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lighthouse": "13.6.0",
    "lint-staged": "17.6.2",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        2,
        "always",
        100
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,css,html}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  }
}

# Sabaq API configuration.
# Copy this file to `.env` for local development. Every variable is optional;
# the values shown are the defaults. Never commit a real `.env` file.

# development | test | production
NODE_ENV=development

# MongoDB connection string. Leave empty during development to use a temporary in-memory
# database filled with demo data. Required in production.
# Atlas example: mongodb+srv://sabaq-app:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Setup guide: docs/guides/mongodb-atlas.md
MONGODB_URI=

# Database used inside the cluster. Keep it dedicated to Sabaq.
MONGODB_DB_NAME=sabaq

# Public address of the web app, exactly as people open it (scheme, host and port).
# Links in e-mails point here, and the API accepts sign-in cookies only from this origin
# (and CORS_ORIGINS): if it does not match, people are signed out on every reload.
APP_URL=http://localhost:5173

# Secret that signs access tokens: at least 32 random characters. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty during development to get a new random secret on every start.
JWT_SECRET=

# Sign-in, sign-up and password e-mail attempts allowed per client address every 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# Outgoing e-mail (SMTP). Required in production; during development, e-mails are written
# to the log instead. Brevo setup guide: docs/guides/email-brevo.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sabaq <no-reply@sabaq.local>

# Network interface and port. Hosting providers such as Render set PORT themselves.
HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent
# Defaults: debug in development, info in production, silent in tests.
LOG_LEVEL=

# Comma-separated browser origins allowed to call the API with credentials,
# for example: https://sabaq.example.com,http://localhost:5173
CORS_ORIGINS=

# Number of reverse proxies in front of the API (default: 1 in production, 0 otherwise).
# Needed so rate limits apply to real client addresses rather than the proxy.
TRUST_PROXY=

# Requests allowed per client address in each window (the health check is exempt).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# How long in-flight requests may take to finish during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# Version reported by the health endpoint. Render's RENDER_GIT_COMMIT is used when unset.
APP_VERSION=
